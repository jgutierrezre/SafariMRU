{
  "manifest_version": 3,
  "name": "Safari MRU Tab Switcher",
  "version": "2.0.0",
  "description": "Provides tab previews and MRU history to the Safari MRU host app.",
  "permissions": ["tabs"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["html2canvas.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
